      <!-- ORDERS: Login con admin + consulta ordenes -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="04 - Shop Orders">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
